#!/usr/bin/env bash
# Usage: git identity <host>[/<path>] "<name>" "<email>"
# Repos with a remote on <host> (under <path>) commit as <name> <email> and use ~/.ssh/<id> for SSH and signing,
# where <id> is <host>[/<path>] with "/" replaced by "-", e.g. github.com-ckoliber
set -euo pipefail

[ $# -eq 3 ] || { echo 'Usage: git identity <host>[/<path>] "<name>" "<email>"' >&2 && exit 1; }
id=${1//\//-} host=${1%%/*} name=$2 email=$3
[[ "$1" == */* ]] && prefix=${1#*/}/ || prefix=
config=$HOME/.config/git/$id identities=$HOME/.config/git/identities

mkdir -p "$(dirname "$config")" "$HOME/.ssh/config.d"
[ -f "$HOME/.ssh/$id" ] || ssh-keygen -t ed25519 -C "$email" -f "$HOME/.ssh/$id" -N ""
git config -f "$config" user.name "$name"
git config -f "$config" user.email "$email"
git config -f "$config" user.signingkey "~/.ssh/$id.pub"
# Repos with a remote under <host>[/<path>] use this identity, and their SSH URLs go through Host <id> with its key,
# an alias of <host> for a path identity (e.g. git@github.com:acme/x.git → git@github.com-acme:acme/x.git)
printf 'Host %s\n  HostName %s\n  IdentityFile ~/.ssh/%s\n  IdentitiesOnly yes\n' "$id" "$host" "$id" >"$HOME/.ssh/config.d/$id"
for url in "git@$host:" "ssh://git@$host/" "https://$host/"; do
  git config -f "$identities" --replace-all "includeIf.hasconfig:remote.*.url:$url${prefix:-*/}**.path" "~/.config/git/$id"
  if [[ "$url" != https* ]]; then
    git config -f "$identities" --replace-all --fixed-value "url.git@$id:$prefix.insteadOf" "$url$prefix" "$url$prefix"
  fi
done

echo "Add this public key to $host for both authentication and signing:"
cat "$HOME/.ssh/$id.pub"
