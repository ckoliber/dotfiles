[init]
	defaultBranch = main

[pull]
	rebase = true

[user]
	useConfigOnly = true

[commit]
	gpgsign = true

[gpg]
	format = ssh

[include]
	path = ~/.config/git/identities

[alias]
	d = pull
	p = push
	st = status
	co = checkout
	br = branch
	cm = commit
	df = diff
	lg = log --oneline --graph --all --decorate
